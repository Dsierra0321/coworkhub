          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });",
                  "if (pm.response.code === 200) { const rows=pm.response.json(); for (const [name,key] of [[\"Sala Andes\",\"andes\"],[\"Sala Caribe\",\"caribe\"],[\"Escritorio B1\",\"inactiva\"]]) { const row=rows.find(x=>x.nombre===name); pm.expect(row).to.exist; pm.collectionVariables.set(key,row.id); } }"
                ]
              }
            }
          ]
        },
